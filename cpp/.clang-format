Language: Cpp
BasedOnStyle: Google
Standard: Latest

IndentWidth: 4
ColumnLimit: 120
PointerAlignment: Left

BreakBeforeBraces: Attach
AllowShortIfStatementsOnASingleLine: true
AllowShortFunctionsOnASingleLine: Inline

IndentAccessModifiers: false
